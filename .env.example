# 复制为 .env 后修改。.env 不要提交到仓库。

# 网关对外端口，浏览器访问 http://localhost:8080
PUBLIC_PORT=8080

# 数据库密码：只用字母和数字，避免在连接串里需要转义
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 首次启动时创建的管理员账号（之后修改这里不会改已有账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 只有启用 HTTPS 后才设为 true
COOKIE_SECURE=false

# 构建平台本体时用的镜像源，留空用官方源。国内服务器上可以填：
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=
NPM_REGISTRY=
