# 复制为 .env 后修改。.env 不要提交到仓库。

# 网关对外端口，浏览器访问 http://localhost:8080
PUBLIC_PORT=8080

# 数据库密码：只用字母和数字，避免在连接串里需要转义
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 首次启动时创建的管理员账号（之后修改这里不会改已有账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 只有启用 HTTPS 后才设为 true
COOKIE_SECURE=false

# 备案号，显示在门户所有页面（含登录页）的底部，留空不显示。改了以后 docker compose up -d 即可，不用重新构建。
# ICP 备案号填网站备案号（主体备案号后面带“-1”之类的那个），链接到 https://beian.miit.gov.cn/
# 公安备案号照公安备案系统上的写，例如：京公网安备11010000000000号
# ICP_BEIAN=京ICP备00000000号-1
ICP_BEIAN=
POLICE_BEIAN=

# 构建平台本体时用的镜像源，留空用官方源。国内服务器上可以填：
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=
NPM_REGISTRY=
